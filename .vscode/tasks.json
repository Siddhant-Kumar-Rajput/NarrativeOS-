{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "NarrativeOS: Build APK",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				"--console=plain",
				"assembleDebug"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "NarrativeOS: Backend tests",
			"type": "shell",
			"command": "backend\\.venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"pytest",
				"backend\\tests",
				"-q"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "test"
		}
	]
}